# ---------------------------------------------------------------------------
# Payment app (Stripe) configuration
# Copy this file to `.env` for LOCAL development only.
# In production, this lives at /etc/divinity/payment.env on the server,
# OUTSIDE the web root — see payment/DEPLOY.md. Never commit a real .env.
# ---------------------------------------------------------------------------

# Stripe API keys — https://dashboard.stripe.com/apikeys
# Use sk_test_/pk_test_ keys for development, sk_live_/pk_live_ in production.
# NOTE: VITE_STRIPE_PUBLISHABLE_KEY is baked into the client bundle at BUILD
# time — if you change it, you must rebuild (pnpm build).
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Server configuration. Production uses port 12600 behind the nginx
# reverse proxy (see payment/DEPLOY.md).
PORT=12600
NODE_ENV=production

# nginx terminates TLS, so the app itself always runs plain HTTP.
USE_HTTPS=false

# Application URL — used for Stripe return URLs after payment.
# Must match the public origin exactly.
APP_URL=https://payments.divinity.fitness
