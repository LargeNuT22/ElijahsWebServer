{
	"name": "elijah-stripe",
	"version": "1.0.0",
	"description": "Stripe payment handling for Divinity Fitness gym mini fridge.",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"pnpm:dev:server\" \"pnpm:dev:client\"",
		"dev:server": "tsx watch --env-file=.env server/index.ts",
		"dev:client": "react-router dev",
		"build": "pnpm run build:client && pnpm run build:server",
		"build:client": "react-router build",
		"build:server": "tsc -p tsconfig.server.json",
		"start": "NODE_ENV=production node --env-file=.env dist/server/index.js",
		"clean": "rimraf dist .react-router",
		"lint": "eslint app/**/*.{ts,tsx} server/**/*.ts",
		"lint:fix": "eslint app/**/*.{ts,tsx} server/**/*.ts --fix",
		"typecheck": "tsc --noEmit"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zei33/elijah-stripe.git"
	},
	"keywords": [
		"stripe",
		"payment",
		"gym",
		"react-router"
	],
	"author": "Zei33",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/zei33/elijah-stripe/issues"
	},
	"homepage": "https://github.com/zei33/elijah-stripe#readme",
	"dependencies": {
		"@react-router/node": "^7.9.3",
		"@remix-run/node": "^2.17.1",
		"@remix-run/react": "^2.17.1",
		"@stripe/react-stripe-js": "^5.0.0",
		"@stripe/stripe-js": "^8.0.0",
		"express": "^5.1.0",
		"isbot": "^5.1.31",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router": "^7.9.3",
		"stripe": "^19.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.34.0",
		"@react-router/dev": "^7.9.3",
		"@types/express": "^5.0.3",
		"@types/node": "^24.3.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"concurrently": "^9.2.1",
		"dotenv": "^17.2.3",
		"eslint": "^9.34.0",
		"eslint-config-love": "^122.0.0",
		"globals": "^16.4.0",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.42.0",
		"vite": "^7.1.9"
	}
}
