# ---------------------------------------------------------------------------
# Contact form (AWS SES) configuration
# Copy this file to `.env` for LOCAL development only.
# In production, supply these via the systemd unit's EnvironmentFile, stored
# OUTSIDE the web root (see SES_SETUP.md). Never commit a real .env.
# ---------------------------------------------------------------------------

# SES region where your sender identity is verified. ap-southeast-2 = Sydney.
SES_REGION=ap-southeast-2

# Verified SES sender identity. Must be an address on a domain/identity you have
# verified in SES. Use a domain you own (divinity.fitness), not hotmail.
SES_FROM="Divinity Health & Fitness <noreply@divinity.fitness>"

# Where contact-form enquiries are delivered (your business inbox).
SES_TO=divinitygym@hotmail.com

# Port the Node server listens on. nginx reverse-proxies /api/ to this.
PORT=3000

# --- AWS credentials -------------------------------------------------------
# PREFERRED: attach an IAM role to the EC2 instance granting ses:SendEmail, and
# leave the two lines below unset — the AWS SDK finds the role automatically.
#
# Only if you cannot use an instance role, uncomment and fill these:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
